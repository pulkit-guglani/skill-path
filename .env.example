# API Environment: "local" | "dev" | "staging" | "prod"
EXPO_PUBLIC_API_ENV=local

# Local dev notes:
# - iOS Simulator: http://localhost:8000/api (automatic)
# - Android Emulator: http://10.0.2.2:8000/api (automatic)
# - Physical device: set your machine's LAN IP, e.g.:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.42:8000/api

