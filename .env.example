# API Environment: "local" | "dev" | "staging" | "prod"
# Default is prod (deployed Railway API) when unset.
EXPO_PUBLIC_API_ENV=prod
EXPO_PUBLIC_API_BASE_URL=https://skill-path-api-production.up.railway.app/api

# Local dev — set EXPO_PUBLIC_API_ENV=local (uses 10.0.2.2 on Android emulator)
# Physical device on same Wi‑Fi: EXPO_PUBLIC_API_BASE_URL=http://192.168.x.x:8000/api
